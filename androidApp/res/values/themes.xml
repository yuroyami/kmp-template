<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The window background before the first Compose frame. Compose draws everything after that. -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_ground</item>
    </style>

    <style name="Theme.App.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_ground</item>
        <!-- The whole icon, not the foreground layer: a white logo vanishes on a white background. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>

</resources>
